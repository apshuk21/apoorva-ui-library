{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@apoorva/icons": ["packages/@apoorva/icons/src"],
      "@apoorva/components": ["packages/@apoorva/components/src"]
    },
    "outDir": "dist"
  },
  "include": [],
  "exclude": ["node_modules", "dist"]
}
